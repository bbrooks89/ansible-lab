#!/bin/sh
# Runs on every boot of a managed node, before sshd starts.
#  1. Generates fresh SSH host keys (the image ships with none, so every
#     container gets its own identity).
#  2. Installs the control node's public key for the 'ansible' user.
set -eu

ssh-keygen -A

i=0
while [ ! -s /lab-pubkey/id_ed25519.pub ]; do
  i=$((i + 1))
  if [ "$i" -gt 60 ]; then
    echo "lab-firstboot: no public key in /lab-pubkey after 60s" >&2
    exit 1
  fi
  sleep 1
done

install -d -m 700 -o ansible -g ansible /home/ansible/.ssh
install -m 600 -o ansible -g ansible /lab-pubkey/id_ed25519.pub /home/ansible/.ssh/authorized_keys
